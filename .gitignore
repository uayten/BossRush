# Pastas geradas pela Unreal - tudo aqui e recriavel, nada vai pro repositorio.
# Sem barra no inicio: pega a pasta em qualquer nivel, inclusive dentro de Plugins/.
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Pasta Build, mas preservando os icones e recursos de empacotamento.
Build/
!Build/*/Resources/

# Plugins ficam de fora por padrao: cada um tem o seu proprio repositorio,
# e o git nao consegue engolir os arquivos de um repositorio dentro de outro.
# O NodeScribe, por exemplo, e um clone a parte de github.com/uayten/NodeScribe
# e precisa ser clonado a mao em cada maquina nova.
/Plugins/*

# Excecoes: estes dois JA sao versionados e continuam sendo.
# O TrueColors mora aqui dentro mesmo; o JoyShockLibrary4Unreal e submodulo.
!/Plugins/TrueColors/
!/Plugins/JoyShockLibrary4Unreal

# Visual Studio / Rider
.vs/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.opendb
*.VC.db
*.VC.opendb

# Xcode (caso algum dia)
*.xcodeproj
*.xcworkspace

# Sistema operacional
Thumbs.db
desktop.ini
.DS_Store
